# Публичный адрес сайта, без слэша в конце (нужен для sitemap, robots, canonical, og:url)
SITE_URL=https://example.ru

# Supabase (self-hosted, порт 8000)
SUPABASE_URL=http://your-host:8000
SUPABASE_KEY=your-anon-key
# Схема проекта в общем инстансе (таблицы НЕ в public)
SUPABASE_SCHEMA=yagya
# service_role — только на сервере, для записи заявок в обход RLS
SUPABASE_SERVICE_KEY=your-service-role-key

# Telegram (уведомления о заявках)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
# Личка для кнопки «Написать в Telegram»
TELEGRAM_CONTACT=https://t.me/ll_tuo_sole

# Соцсети
INSTAGRAM_URL=https://www.instagram.com/ll_tuo_sole/

# Аналитика
YANDEX_METRIKA_ID=

# Реквизиты оператора персональных данных (152-ФЗ) — выводятся в подвале и в документах
OPERATOR_NAME=ИП Фамилия Имя Отчество
OPERATOR_INN=
OPERATOR_OGRN_LABEL=ОГРНИП
OPERATOR_OGRN=
OPERATOR_ADDRESS=
OPERATOR_EMAIL=
# true — только если база данных заявок физически находится в РФ (иначе в политике честно сказано про зарубежное хранение)
OPERATOR_DB_IN_RU=false
